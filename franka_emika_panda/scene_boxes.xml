<mujoco model="panda scene">
  <include file="panda.xml"/>

  <statistic center="0.3 0 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- ==================== COLOR BLOCKS (Dynamic) ==================== -->
    <!-- Red Block -->
    <body name="red_block" pos="0.4 -0.15 0.025">
      <joint name="red_joint" type="free"/>
      <geom name="red_geom" type="box" size="0.02 0.02 0.02" rgba="1 0 0 1" condim="6" friction="1.0 0.005 0.0001" mass="0.1"/>
    </body>

    <!-- Green Block -->
    <body name="green_block" pos="0.4 0.0 0.025">
      <joint name="green_joint" type="free"/>
      <geom name="green_geom" type="box" size="0.02 0.02 0.02" rgba="0 1 0 1" condim="6" friction="1.0 0.005 0.0001" mass="0.1"/>
    </body>

    <!-- Blue Block -->
    <body name="blue_block" pos="0.4 0.15 0.025">
      <joint name="blue_joint" type="free"/>
      <geom name="blue_geom" type="box" size="0.02 0.02 0.02" rgba="0 0.4 1 1" condim="6" friction="1.0 0.005 0.0001" mass="0.1"/>
    </body>

    <!-- ==================== TARGET PADS (Static landmarks) ==================== -->
    <body name="black_pad" pos="0.55 -0.1 0.001">
      <geom name="black_pad_geom" type="box" size="0.05 0.05 0.001" rgba="0.1 0.1 0.1 1" conaffinity="0" contype="0"/>
    </body>

    <body name="white_pad" pos="0.55 0.1 0.001">
      <geom name="white_pad_geom" type="box" size="0.05 0.05 0.001" rgba="0.9 0.9 0.9 1" conaffinity="0" contype="0"/>
    </body>
  </worldbody>
</mujoco>